// Global brightness
$gb = 1.085

// Base colors of the dark theme. Components use them through the theme
// functions below, which resolve to CSS variables that styles/theme.styl
// defines for each theme.
$bright1 = #b5b5b5 * 1.05 * $gb
$bright2 = $bright1 * 0.71

$dark1 = rgb(48,48,55) * 0.83 * $gb
$dark2 = $dark1 * 0.7

// Brightness factors of the base colors available to components
$shadeFactors = 0.5 0.55 0.6 0.7 0.75 0.8 0.83 0.84 0.85 0.9 0.95 1 1.075 1.1 1.15 1.2 1.25 1.3 1.35 1.4 1.5 1.6 1.7 1.85 1.9 2.4

shade-variable(name, f)
  '--' + name + '-' + round(f * 1000)

// A base color scaled by factor f with opacity a, like rgba($dark1 * f, a).
// In the light theme, dark colors become light surfaces and bright colors
// become dark text, with factors above 1 adding contrast to the background.
shade(name, f, a)
  unless f in $shadeFactors
    error('Shade factor ' + f + ' is missing from $shadeFactors')
  c = 'var(' + shade-variable(name, f) + ')'
  if a < 1
    c = 'color-mix(in srgb, ' + c + ' ' + (a * 100) + '%, transparent)'
  unquote(c)

dark1(f = 1, a = 1)
  shade('dark1', f, a)

dark2(f = 1, a = 1)
  shade('dark2', f, a)

bright1(f = 1, a = 1)
  shade('bright1', f, a)

bright2(f = 1, a = 1)
  shade('bright2', f, a)

// White in the dark theme and black in the light theme with opacity a,
// for overlays that lift elements from the background
tint(a)
  unquote('rgb(var(--tint) / ' + a + ')')

// Outline of text drawn over the viewport, contrasting the text color
halo(a)
  unquote('rgb(var(--halo) / ' + a + ')')

// Black shadow with opacity a, left out in the light theme
shadow(a)
  unquote('rgb(0 0 0 / calc(' + a + ' * var(--shadow-strength)))')

$highlight = #0090ff
$confirm = #b9ff64
$cancel = #ff6f6f
$warn = #ffbb40
$projected = #51bb89 // Projected sketch geometry, as in materials.js
$brokenProjected = #ff6f6f // Projections whose source was lost, as in materials.js

$blue = #4b8ee3
$purple = #a052f7
$pink = #ee3367
$orange = #ea6a43
$green = #15c115
$red = #f52b2b
$yellow = #ffbb40
