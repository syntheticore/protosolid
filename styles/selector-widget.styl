.panel
  width: max-content
  padding-top: 8px

.actions.bordered
  display: flex
  background: $dark2
  &::after
    content: none

button
  margin: 0
  width: 36px
  padding: 6px 0
  display: flex
  justify-content: center
  background: none
  border: none
  color: $bright2
  font-size: 12px
  border-radius: 0
  &:first-child
    border-radius: 4px 0 0 4px
  &:last-child
    border-radius: 0 4px 4px 0
  &:only-child
    border-radius: 4px
  &:hover
    color: $bright1
    background: $dark1
  &:active
    background: $dark2 * 0.85
  &:disabled
    opacity: 0.3
