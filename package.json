{
  "name": "protosolid",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:exhaustive": "node --import ./tests/helpers/exhaustive.mjs --test tests/*.test.js",
    "dev": "npm run build-shapex && nuxt dev",
    "dev-tauri": "npm run build-shapex && npm run prepare-assets && tauri dev",
    "build": "npm run build-shapex && npm run clean && npm run prepare-assets && npm run generate",
    "pack": "tauri build",
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "build-shapex": "npm run build --prefix js/shapexJS",
    "generate": "nuxt generate",
    "clean": "node scripts/clean.mjs",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/comfortaa": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "nuxt": "^3.15.4",
    "vue": "latest"
  },
  "overrides": {
    "vue": "latest"
  },
  "devDependencies": {
    "@fortawesome/free-solid-svg-icons": "^5.15.2",
    "@fortawesome/vue-fontawesome": "^3.0.3",
    "@pinia/nuxt": "^0.5.2",
    "@resvg/resvg-js": "^2.6.2",
    "@salusoft89/planegcs": "^1.2.0",
    "@tauri-apps/cli": "^2.12.4",
    "jszip": "^3.10.1",
    "nanoevents": "^9.0.0",
    "nib": "^1.2.0",
    "opentype.js": "^2.0.0",
    "pinia": "^2.2.0",
    "pluralize": "^8.0.0",
    "pug": "^3.0.3",
    "stylus": "^0.63.0",
    "three": "^0.186.0",
    "three-gpu-pathtracer": "0.0.24",
    "three-mesh-bvh": "0.9.15",
    "wasm-pack": "^0.15.0",
    "xatlas-web": "0.1.0"
  }
}
