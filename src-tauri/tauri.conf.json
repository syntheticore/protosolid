{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProtoSolid",
  "version": "../package.json",
  "identifier": "org.protosolid.desktop",
  "build": {
    "beforeDevCommand": "npx nuxt dev --port 3000",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../.output/public"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "Parametric CAD",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
