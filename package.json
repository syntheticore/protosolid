{
  "name": "protosolid",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "dev": "npm run build-shapex && nuxt dev",
    "dev-electron": "npm run build-shapex && electron ./electron",
    "build": "npm run build-oc && npm run build-shapex && npm run build-app",
    "pack": "npm run prepare-icons && npm run build-app && cd electron && electron-builder",
    "prepare-icons": "node scripts/prepare-electron-icons.mjs",
    "build-oc": "cd assets/oc && docker run --rm -it -v \"$(pwd):/src\" -u \"$(id -u):$(id -g)\" donalffons/opencascade.js oc.yml",
    "build-oc-win": "cd assets/oc && docker run --rm -it -v \".\\:/src\" donalffons/opencascade.js oc.yml",
    "build-shapex": "npm run build --prefix js/shapexJS",
    "build-app": "npm run clean && npm run generate && node scripts/copy-generated-app.mjs",
    "generate": "nuxt generate",
    "clean": "node scripts/clean.mjs",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "nuxt": "^3.15.4",
    "vue": "latest"
  },
  "overrides": {
    "vue": "latest"
  },
  "devDependencies": {
    "@fortawesome/free-solid-svg-icons": "^5.15.2",
    "@fortawesome/vue-fontawesome": "^3.0.3",
    "@pinia/nuxt": "^0.5.2",
    "@salusoft89/planegcs": "^1.2.0",
    "electron": "44.9.0",
    "electron-builder": "^24.13.3",
    "jszip": "^3.10.1",
    "nanoevents": "^9.0.0",
    "nib": "^1.2.0",
    "nuxt-electron": "^0.7.0",
    "pinia": "^2.2.0",
    "pluralize": "^8.0.0",
    "pug": "^3.0.3",
    "stylus": "^0.63.0",
    "three": "^0.186.0",
    "three-gpu-pathtracer": "0.0.24",
    "three-mesh-bvh": "0.9.15",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5",
    "wasm-pack": "^0.15.0",
    "xatlas-web": "0.1.0"
  }
}
