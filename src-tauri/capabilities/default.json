{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Events, window dragging and the native alert and confirm dialogs for the app windows",
  "windows": ["main", "preferences", "splash"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "dialog:allow-message"
  ]
}
